# syntax=docker/dockerfile:1
# ==============================================================================
# DevLab Portal Web SSO Frontend — Production Container
# Optimized for Google Cloud Run, Render, and Enterprise OCI Runtimes
# Author: yuva.devlab@gmail.com
# ==============================================================================

FROM node:24-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# ─── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.json prisma.config.ts ./
COPY prisma ./prisma

COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM base AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY --from=deps /app ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm db:generate
RUN pnpm --filter @devlab/portal-web... build

# ─── Stage 3: Runner ──────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create non-root system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone bundle and static assets
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/public ./devlab-portal/apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./devlab-portal/apps/web/.next/static

USER nextjs

EXPOSE 3000

CMD ["sh", "-c", "if [ -f devlab-portal/apps/web/server.js ]; then node devlab-portal/apps/web/server.js; else node apps/web/server.js; fi"]
