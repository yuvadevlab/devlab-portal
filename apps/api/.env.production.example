# ==============================================================================
# DevLab Portal API Control Plane — Production Environment Template
# Author: yuva.devlab@gmail.com
# ==============================================================================

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── Authority Identity & OIDC Issuer ────────────────────────────────────────
# Public HTTPS URL of this deployed Portal API (used in JWT "iss" claim)
OIDC_ISSUER=https://portal-api.yourdomain.com

# Canonical Web URL of the Portal frontend (for OAuth/SSO redirects)
PORTAL_ORIGIN=https://portal.yourdomain.com

# ─── Database Connection ─────────────────────────────────────────────────────
# PostgreSQL 16 connection string (Neon / Supabase with pooling)
DATABASE_URL=postgresql://user:password@host:5432/devlab_portal?sslmode=require

# ─── Redis Cache & Session Invalidation ──────────────────────────────────────
# Optional: Serverless Redis (Upstash) or managed Redis instance.
# If omitted or unreachable, Portal automatically runs in DEGRADED mode.
REDIS_URL=rediss://default:your-token@your-redis-endpoint.upstash.io:6379

# ─── Security & Cryptography ─────────────────────────────────────────────────
# 64-character random string used for session tokens & cookie encryption
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_or_uuid_string

# ─── Cross-Origin Resource Sharing (CORS) ────────────────────────────────────
# Comma-separated list of permitted consumer origins
CORS_ORIGIN=https://portal.yourdomain.com,https://finai.yourdomain.com
